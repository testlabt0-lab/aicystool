# Application Settings
APP_NAME=Sentinel AI
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://sentinel:sentinel_pass@localhost:5432/sentinel_ai

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security Settings
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ML Model Paths
MODEL_PATH=./models/trained
DDOS_MODEL_PATH=./models/ddos_model.pkl
MALWARE_MODEL_PATH=./models/malware_cnn.h5
SQLI_MODEL_PATH=./models/sqli_model.pkl
BRUTEFORCE_MODEL_PATH=./models/bruteforce_model.pkl

# Detection Thresholds (0.0 - 1.0)
DDOS_THRESHOLD=0.85
MALWARE_THRESHOLD=0.75
SQLI_THRESHOLD=0.80
BRUTEFORCE_THRESHOLD=0.70
ANOMALY_THRESHOLD=0.75

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
LOGIN_ATTEMPT_THRESHOLD=5
TIME_WINDOW_SECONDS=300

# Alerting Configuration
ALERT_EMAIL=admin@example.com
SLACK_WEBHOOK_URL=
ENABLE_EMAIL_ALERTS=false

# Performance Settings
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=30
BATCH_SIZE=32
