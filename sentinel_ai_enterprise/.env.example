# Sentinel AI Enterprise - Environment Variables Template

# ===========================================
# إعدادات التطبيق الأساسية
# ===========================================
APP_NAME=Sentinel AI Enterprise
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=production

# ===========================================
# إعدادات الخادم
# ===========================================
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ===========================================
# قاعدة البيانات PostgreSQL
# ===========================================
DATABASE_URL=postgresql://sentinel_user:SECURE_PASSWORD_HERE@localhost:5432/sentinel_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ===========================================
# Kafka (لل معالجة في الوقت الفعلي)
# ===========================================
KAFKA_BOOTSTRAP_SERVERS=kafka1:9092,kafka2:9092,kafka3:9092
KAFKA_TOPIC_TRAFFIC=network-traffic
KAFKA_TOPIC_LOGS=security-logs
KAFKA_TOPIC_ALERTS=security-alerts

# ===========================================
# مفاتيح الأمان والتشفير
# IMPORTANT: Generate secure random values for production!
# ===========================================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ENCRYPTION_KEY=your-encryption-key-min-32-characters-long-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# DDoS Detection Settings
# ===========================================
DDOS_WINDOW_SIZE=60
DDOS_THRESHOLD_RPS=10000
DDOS_AUTO_MITIGATION=true
DDOS_CLOUDFLARE_API_KEY=your-cloudflare-api-key-here
DDOS_AWS_SHIELD_ENABLED=false

# ===========================================
# Malware Detection Settings
# ===========================================
MALWARE_MAX_FILE_SIZE=104857600
MALWARE_SANDBOX_ENABLED=true
MALWARE_YARA_RULES_PATH=./configs/yara_rules

# ===========================================
# SQL Injection Detection Settings
# ===========================================
SQLI_NLP_MODEL=bert-base-uncased
SQLI_WAF_INTEGRATION=true
SQLI_BLOCK_MODE=true

# ===========================================
# Brute Force Detection Settings
# ===========================================
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_WINDOW=300
BRUTE_FORCE_LOCKOUT_DURATION=1800
BRUTE_FORCE_MFA_TRIGGER=true

# ===========================================
# Log Analysis Settings
# ===========================================
LOG_RETENTION_DAYS=90
LOG_BATCH_PROCESSING_SIZE=10000
LOG_REAL_TIME_ENABLED=true

# ===========================================
# Threat Intelligence
# ===========================================
THREAT_INTEL_ENABLED=true
THREAT_INTEL_SOURCES=misp,alienvault_otx,abuse_ch,virustotal
THREAT_INTEL_UPDATE_INTERVAL=3600

# ===========================================
# SOAR (Security Orchestration)
# ===========================================
SOAR_ENABLED=true
SOAR_PLAYBOOKS_PATH=./configs/playbooks
SOAR_JIRA_URL=https://your-company.atlassian.net
SOAR_SERVICENOW_URL=https://your-company.service-now.com

# ===========================================
# RBAC & Admin
# ===========================================
RBAC_ENABLED=true
ADMIN_EMAILS=admin@company.com,security@company.com

# ===========================================
# Monitoring & Alerting
# ===========================================
MONITORING_ENABLED=true
PROMETHEUS_ENDPOINT=/metrics
GRAFANA_URL=https://grafana.your-company.com

# Email Alerts
ALERT_EMAIL_ENABLED=true
ALERT_SMTP_SERVER=smtp.company.com
ALERT_SMTP_PORT=587
ALERT_EMAIL_FROM=alerts@sentinel.ai
ALERT_EMAIL_TO=soc@company.com,security-team@company.com

# Slack Alerts
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Microsoft Teams Alerts
ALERT_TEAMS_ENABLED=false
ALERT_TEAMS_WEBHOOK=https://outlook.office.com/webhook/YOUR/WEBHOOK/URL

# PagerDuty Alerts
ALERT_PAGERDUTY_ENABLED=false
ALERT_PAGERDUTY_KEY=your-pagerduty-integration-key

# ===========================================
# Performance Settings
# ===========================================
RATE_LIMIT_PER_SECOND=1000
RATE_LIMIT_PER_MINUTE=50000
CACHE_ENABLED=true
COMPRESSION_ENABLED=true

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./data/logs/sentinel.log
LOG_MAX_SIZE=100
LOG_BACKUP_COUNT=10

# ===========================================
# CORS Origins
# ===========================================
CORS_ORIGINS=http://localhost:3000,https://dashboard.sentinel.ai

# ===========================================
# Cloud Integrations (Optional)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

GCP_PROJECT_ID=
GCP_CREDENTIALS_FILE=

AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# ===========================================
# GeoIP Settings (Optional)
# ===========================================
MAXMIND_LICENSE_KEY=your-maxmind-license-key
GEOIP_DATABASE_PATH=./data/geoip/GeoLite2-City.mmdb
