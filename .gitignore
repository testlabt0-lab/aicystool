```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
venv/
.venv/
env/

# Logs
*.log

# Environment files
.env
.env.local
*.env.*

# Dependencies
node_modules/

# Build/dist directories
build/
dist/
target/

# Coverage reports
.coverage
coverage/
htmlcov/

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# System files
.DS_Store
Thumbs.db

# MyPy cache
.mypy_cache/

# Pytest cache
.pytest_cache/
```